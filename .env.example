# Template for .env. Copy it, fill in real values, and keep the copy out of Git:
#
#     cp .env.example .env
#
# .env is listed in .gitignore. Never commit credentials, and never move them into
# application.properties - that file is checked in.
#
# HOW THIS FILE REACHES THE S3 FILESYSTEM
#
# Quarkus reads .env from the working directory into its own configuration, which is why starting
# the application from an IDE works with nothing else set up. The S3 provider does not read Quarkus
# configuration though - it reads system properties. application.properties bridges the two by
# referencing the names below:
#
#     docs.data-dir-properties."aws.accessKeyId"=${AWS_ACCESS_KEY_ID:}
#
# The same line also picks up real environment variables, which is how a Kubernetes secret arrives,
# so local and cluster use the identical three names and the application knows no difference.
#
# What .env cannot do is populate the process environment - Java offers no API to change it once
# the JVM runs. That only matters for S3DataStoreTest, which calls System.getenv() directly, and
# for a "java -jar" started outside the project directory. Both want the file sourced first:
#
#     set -a; source .env; set +a        # scripts/run-with-env.sh does this

# Credentials for the S3 corpus store. In Kubernetes these come from a Secret instead, mounted as
# environment variables - same three names.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# A self-hosted store (MinIO and its forks) ignores the region, but the SDK refuses to sign a
# request without one, so it has to be set to something.
AWS_REGION=us-east-1

# Only read by S3DataStoreTest. Without it those tests skip, which is what an ordinary build wants.
KVASIR_S3_LOCATION=s3x://s3.example.com/my-bucket

# ------------------------------------------------------------------------------------------------
# Addresses of your own environment. application.properties deliberately holds harmless local
# defaults - a plain "data" directory and localhost:9200 - because that file is public and an
# address is environment specific. Yours belong here.
#
# NOTE THE _DEV_ AND _PROD_ PREFIXES. They are not decoration. An environment variable outranks
# application.properties, and that includes the profile-specific %test.docs.data-dir: written as a
# plain DOCS_DATA_DIR, this line would send the whole test suite at your real corpus instead of the
# fixture tree. Measured, not suspected. The prefixes bind the value to one profile - _DEV_ for
# quarkus:dev, _PROD_ for a packaged run - and leave tests alone.
# ------------------------------------------------------------------------------------------------

_DEV_DOCS_DATA_DIR=s3x://s3.example.com/my-bucket
_PROD_DOCS_DATA_DIR=s3x://s3.example.com/my-bucket

_DEV_QUARKUS_HIBERNATE_SEARCH_STANDALONE_ELASTICSEARCH_HOSTS=opensearch.example.com:9200
_PROD_QUARKUS_HIBERNATE_SEARCH_STANDALONE_ELASTICSEARCH_HOSTS=opensearch.example.com:9200

# The test suite needs a reachable OpenSearch - it creates its own index under the prefix "test-"
# and drops it again at the end. Without this line the default localhost:9200 applies, which is
# what "docker compose up opensearch" in docker/ provides. _TEST_ is safe here: it binds only the
# address to the test profile and leaves %test.docs.data-dir, the fixture tree, alone.
_TEST_QUARKUS_HIBERNATE_SEARCH_STANDALONE_ELASTICSEARCH_HOSTS=opensearch.example.com:9200
