<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.kvasir</groupId>
    <artifactId>kvasir-mcp-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.33.3.1</quarkus.platform.version>
        <!-- Parser libraries; not managed by any Quarkus BOM, so pinned here. -->
        <flexmark.version>0.64.8</flexmark.version>
        <jsoup.version>1.23.1</jsoup.version>
        <javaparser.version>3.28.2</javaparser.version>
        <jimfs.version>1.3.2</jimfs.version>
        <s3-nio.version>2.5.0</s3-nio.version>
        <wiremock.version>3.13.2</wiremock.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-langchain4j-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-search-standalone-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-core</artifactId>
        </dependency>
        <!--
            In-process embedding models. All four options of docs.embedding.model have to be on the
            classpath, otherwise switching between them would not work without touching code.
            Versions come from quarkus-langchain4j-bom; these artifacts are only ever released as
            -beta, so there is no stable line to pin to instead.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2-q</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-bge-small-en-q</artifactId>
        </dependency>
        <!-- Markdown, chunked along headings -->
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark</artifactId>
            <version>${flexmark.version}</version>
        </dependency>
        <!-- HTML documentation and legacy package.html -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <!--
            NIO filesystem provider for S3. Nothing calls it directly: DataStore resolves
            docs.data-dir=s3://... through FileSystems.newFileSystem, and scanner and parsers only
            ever see the Path tree it spans.
        -->
        <dependency>
            <groupId>software.amazon.nio.s3</groupId>
            <artifactId>aws-java-nio-spi-for-s3</artifactId>
            <version>${s3-nio.version}</version>
        </dependency>
        <!-- Java sources from a sources JAR, including package-info.java -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!--
            Health endpoints under /q/health. Kubernetes needs all three: a startup probe to sit
            out the seconds the ONNX model takes to load, a liveness probe to notice a wedged
            process, and a readiness probe that keeps traffic away while the search backend is
            unreachable.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!--
            Source catalog (planned, see CLAUDE.md "Geplant: Inhalte direkt aus Artifactory, Git
            und Wiki"). What gets stored here is where content comes from - Maven coordinates, a
            repository path and ref, a wiki space - never the content itself. Documents stay in the
            search index, which remains the only durable copy of them.

            Two Hibernate worlds share the classpath from here on, and confusing them is the
            mistake to watch for: DocChunk and IndexedFile are mapped by the *standalone* Hibernate
            Search mapper into OpenSearch, SourceDefinition is a JPA entity in Postgres. The
            standalone mapper does not read ORM metadata, so an @Indexed on a JPA entity would
            silently index nothing at all.

            Retrieval must never depend on this datasource. Searching answers from the index alone;
            an unreachable Postgres may stop indexing, exactly as an unreachable object store does
            today, but it must not take the MCP tools down with it.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!--
            Versioned schema for that catalog. A drop-and-create strategy is out of the question:
            the catalog is the only record of what is supposed to be indexed, and losing it means
            nobody knows what to fetch again - the index itself does not say where its chunks came
            from in a form that could be replayed.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!--
            Per-source refresh interval. Released Maven versions are immutable and need looking at
            exactly once; SNAPSHOTs, Git branches and wiki pages change under us and have to be
            polled. Without a scheduler every update would need someone to call /admin/index.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!--
            Two dependencies deliberately NOT added, so nobody adds them by reflex later:

            * No HTTP client extension. java.net.http.HttpClient covers this and brings two things
              that matter here for free: it does not follow redirects unless told to - which is
              exactly the rule that a source may never reach a host other than the one behind its
              configured repository id - and BodyHandlers.ofFile streams a sources JAR of any size
              straight to the temp file that DataStore would stage it in anyway, without it ever
              being a byte[] on the heap. A declarative REST client would also fit badly: base URLs
              come from the repository registry at runtime, not from build-time configuration.

            * No Maven Resolver (org.apache.maven.resolver). Fetching one -sources.jar by exact
              coordinates and reading maven-metadata.xml for the version list is a handful of GETs
              and a StAX parse. The resolver would drag in settings.xml, mirrors and a local
              repository - and with them the one behaviour the security rule forbids outright: a
              silent fallback to Maven Central when a repository is not configured.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory NIO filesystem: proves the scanner works off the default provider -->
        <dependency>
            <groupId>com.google.jimfs</groupId>
            <artifactId>jimfs</artifactId>
            <version>${jimfs.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            A stand-in for Artifactory, Forgejo and Confluence at HTTP level. The cases worth
            testing are precisely the ones a real server will not perform on request: a 302 to
            another host that must not be followed, an unchanged ETag that has to skip the download
            entirely, a 404 on one artifact that must not fail the whole run, a hanging connection.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Polling the asynchronous scan status without hand-rolled sleeps -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                    <!--
                        The in-process embedding models load a native tokenizer library, and that
                        can only ever be loaded by one class loader per JVM. A @TestProfile makes
                        Quarkus restart with a fresh class loader, so any test that switches the
                        model has to run in a JVM of its own - see the execution below.
                    -->
                    <excludes>
                        <exclude>**/SwitchedEmbeddingModelTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>switched-embedding-model</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>none</exclude>
                            </excludes>
                            <includes>
                                <include>**/SwitchedEmbeddingModelTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
